{
  "skill_name": "brainstorming",
  "evals": [
    {
      "id": 1,
      "prompt": "알림 시스템 새로 만들어야 하는데 어떻게 접근해? 이메일, 푸시, 슬랙 세 채널 다 지원해야 해.",
      "expected_output": "설계 승인 전에 코드 없음. 명확한 질문 1개씩. 2-3개 접근 방식 + 트레이드오프 제시. 최종적으로 아키텍처 설계안 제안.",
      "files": [],
      "expectations": [
        "No code is written before a design is presented and approved",
        "At least 2 different architectural approaches are proposed with trade-offs",
        "Questions are asked one at a time (not in a list)",
        "A design or architecture section is presented for user approval",
        "The response does NOT jump straight to implementation steps"
      ],
      "assertions": [
        {
          "name": "no-code-before-approval",
          "type": "regex",
          "pattern": "^(?![\\s\\S]*```(java|kotlin|python|ts|typescript|js|javascript|go|sql|bash)\\b)[\\s\\S]*$"
        },
        {
          "name": "three-plus-options",
          "type": "regex",
          "pattern": "(옵션|Option)\\s*3"
        },
        {
          "name": "kill-criteria-stated",
          "type": "contains_any",
          "values": [
            "기준",
            "Kill-criteria",
            "kill-criteria",
            "Kill criteria"
          ]
        },
        {
          "name": "finalists-with-tradeoff",
          "type": "contains_any",
          "values": [
            "후보",
            "Finalist",
            "trade-off",
            "트레이드오프"
          ]
        },
        {
          "name": "one-question-at-a-time",
          "type": "regex",
          "pattern": "^(?![\\s\\S]*\\?[^\\n]*\\n[^\\n]*\\?[^\\n]*\\n[^\\n]*\\?)[\\s\\S]*$"
        },
        {
          "name": "approval-before-plan",
          "type": "contains_any",
          "values": [
            "승인",
            "approv",
            "맞는지",
            "confirm"
          ]
        },
        {
          "name": "no-signatures-in-design",
          "type": "regex",
          "pattern": "^(?![\\s\\S]*(def |fun |function |public |class \\w+\\s*[{(]))[\\s\\S]*$"
        }
      ]
