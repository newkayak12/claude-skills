diff --git a/payment/src/main/kotlin/io/payflow/payment/RetryPolicy.kt b/payment/src/main/kotlin/io/payflow/payment/RetryPolicy.kt
--- a/payment/src/main/kotlin/io/payflow/payment/RetryPolicy.kt
+++ b/payment/src/main/kotlin/io/payflow/payment/RetryPolicy.kt
@@ -1,14 +1,26 @@
 package io.payflow.payment

-class RetryPolicy(private val maxAttempts: Int = 10) {
+import kotlin.math.min
+import kotlin.random.Random
+
+class RetryPolicy(
+    private val maxAttempts: Int = 5,
+    private val baseDelayMs: Long = 200,
+    private val maxDelayMs: Long = 5_000,
+) {
     fun <T> run(block: () -> T): T {
         var attempt = 0
         while (true) {
             try {
                 return block()
             } catch (e: PgTimeoutException) {
                 attempt++
                 if (attempt >= maxAttempts) throw e
-                // retry immediately
+                val exp = min(maxDelayMs, baseDelayMs shl (attempt - 1))
+                val jitter = Random.nextLong(0, exp / 2 + 1)
+                Thread.sleep(exp + jitter)
             }
         }
     }
 }
